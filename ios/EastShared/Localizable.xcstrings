        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매일의 지혜를 위한 고요한 공간."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Een stille plek voor de dagelijkse wijsheid."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cicha przestrzeń na codzienną mądrość."
          }
