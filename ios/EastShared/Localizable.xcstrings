          "stringUnit" : {
            "state" : "translated",
            "value" : "Un espace silencieux pour la sagesse quotidienne."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uno spazio silenzioso per la saggezza quotidiana."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日々の知恵のための静かな場所。"
