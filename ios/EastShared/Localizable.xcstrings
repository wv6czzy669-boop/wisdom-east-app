{
  "sourceLanguage" : "en",
  "strings" : {
    "A quiet space for the day's wisdom." : {
      "comment" : "EastWidget gallery description (WidgetKit configurationDisplayName sibling). Reuses each locale's already-reviewed \"daily wisdom\" (appTitle) and \"quiet/silent\" (notificationPermissionTitle) vocabulary from lib/l10n.",
      "extractionState" : "stale",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مساحة هادئة للحكمة اليومية."
          }
        },
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ein stiller Ort für die tägliche Weisheit."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A quiet space for the day's wisdom."
          }
        },
        "es" : {
          "stringUnit" : {
