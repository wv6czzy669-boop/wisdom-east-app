{
  "sourceLanguage": "en",
  "strings": {
    "NSFaceIDUsageDescription": {
      "comment": "Permission to unlock private writing. Device passcode remains a fallback.",
      "extractionState": "manual",
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Use Face ID to unlock your private writing."
          }
        },
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Özel yazılarının kilidini açmak için Face ID kullan."
          }
        },
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Entsperre deine privaten Texte mit Face ID."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID para desbloquear tus escritos privados."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilise Face ID pour déverrouiller tes écrits privés."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Face ID per sbloccare i tuoi scritti privati."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Face ID om je persoonlijke teksten te ontgrendelen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj Face ID, aby odblokować swoje prywatne zapiski."
          }
        },
        "pt-BR": {
          "stringUnit": {
            "state": "translated",
            "value": "Use o Face ID para desbloquear seus textos privados."
          }
        },
        "ar": {
          "stringUnit": {
            "state": "translated",
            "value": "استخدم Face ID لفتح كتاباتك الخاصة."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Face IDでプライベートな記録のロックを解除します。"
          }
        },
        "ko": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID로 나만의 글의 잠금을 해제하세요."
          }
        },
        "zh-Hant": {
          "stringUnit": {
            "state": "translated",
            "value": "使用 Face ID 解鎖你的私人書寫。"
          }
        },
        "th": {
          "stringUnit": {
            "state": "translated",
            "value": "ใช้ Face ID เพื่อปลดล็อกข้อเขียนส่วนตัวของคุณ"
          }
        },
        "vi": {
          "stringUnit": {
            "state": "translated",
            "value": "Dùng Face ID để mở khóa những trang viết riêng tư của bạn."
          }
        }
      }
    }
  },
  "version": "1.0"
